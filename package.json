{
  "name": "jetrouter",
  "version": "0.1.1",
  "description": "A fast, zero-dependency HTTP routing engine.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Hamza-Qureshi09",
    "url": "https://github.com/Codexa-by-HQ"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "router",
    "http",
    "routing",
    "esm",
    "typescript",
    "bun",
    "deno",
    "zero-dependency"
  ],
  "scripts": {
    "test": "node test/run.js",
    "test:types": "tsc -p test/tsconfig.json",
    "test:source": "node test/source.test.js",
    "test:memory": "node --expose-gc test/memory.test.js",
    "format:check": "prettier --check src test package.json docs README.md .github",
    "format": "prettier --write src test package.json docs README.md .github",
    "check": "npm test && npm run test:types && npm run test:source && npm run format:check",
    "prepublishOnly": "npm run check && npm run test:memory"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codexa-by-HQ/jetrouter.git"
  },
  "homepage": "https://github.com/Codexa-by-HQ/jetrouter#readme",
  "bugs": {
    "url": "https://github.com/Codexa-by-HQ/jetrouter/issues"
  }
}
